{
  "openapi": "3.0.3",
  "info": {
    "title": "Dabber Khdma — moteur IA privé",
    "version": "1.0.0",
    "description": "Composant technique hors du décompte des six microservices métier. Aucun routage public, aucune connexion directe du frontend."
  },
  "servers": [
    {
      "url": "http://ai-engine:8090",
      "description": "Réseau interne de démonstration prévu"
    }
  ],
  "paths": {
    "/v1/extract": {
      "post": {
        "operationId": "engine_extract",
        "summary": "Extraire les suggestions du CV envoyé par le backend",
        "description": "Réseau privé uniquement. Appel par un backend authentifié avec audience ai-engine et scope spécifique; aucun jeton de navigateur accepté. Le calcul ne modifie aucune donnée métier.",
        "security": [
          {
            "serviceAuth": []
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "multipart/form-data": {
              "schema": {
                "$ref": "#/components/schemas/ExtractInput"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Résultat à valider par le backend",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ExtractResult"
                }
              }
            }
          },
          "400": {
            "description": "Entrée invalide",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "401": {
            "description": "Identité de service invalide",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "403": {
            "description": "Scope insuffisant",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "413": {
            "description": "Entrée trop volumineuse",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "422": {
            "description": "Document inexploitable",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "503": {
            "description": "Calcul indisponible",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/v1/score": {
      "post": {
        "operationId": "engine_score",
        "summary": "Calculer les scores sur les données minimisées du backend",
        "description": "Réseau privé uniquement. Appel par un backend authentifié avec audience ai-engine et scope spécifique; aucun jeton de navigateur accepté. Le calcul ne modifie aucune donnée métier.",
        "security": [
          {
            "serviceAuth": []
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ScoreInput"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Résultat à valider par le backend",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ScoreResult"
                }
              }
            }
          },
          "400": {
            "description": "Entrée invalide",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "401": {
            "description": "Identité de service invalide",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "403": {
            "description": "Scope insuffisant",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "413": {
            "description": "Entrée trop volumineuse",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "422": {
            "description": "Document inexploitable",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "503": {
            "description": "Calcul indisponible",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "serviceAuth": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "JWT de service"
      }
    },
    "schemas": {
      "Error": {
        "type": "object",
        "properties": {
          "code": {
            "type": "string"
          },
          "message": {
            "type": "string"
          },
          "jobId": {
            "type": "string",
            "format": "uuid"
          }
        },
        "additionalProperties": false,
        "required": [
          "code",
          "message",
          "jobId"
        ]
      },
      "ExtractInput": {
        "type": "object",
        "properties": {
          "jobId": {
            "type": "string",
            "format": "uuid"
          },
          "file": {
            "type": "string",
            "format": "binary"
          },
          "inputHash": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          }
        },
        "additionalProperties": false,
        "required": [
          "jobId",
          "file",
          "inputHash"
        ]
      },
      "ExtractResult": {
        "type": "object",
        "properties": {
          "jobId": {
            "type": "string",
            "format": "uuid"
          },
          "inputHash": {
            "type": "string"
          },
          "extractorVersion": {
            "type": "string"
          },
          "suggestions": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "fieldKey": {
                  "type": "string",
                  "enum": [
                    "displayName",
                    "headline",
                    "bio",
                    "skillCodes",
                    "experience",
                    "education",
                    "languages"
                  ]
                },
                "value": {
                  "type": "string"
                },
                "confidence": {
                  "type": "number",
                  "minimum": 0,
                  "maximum": 1
                }
              },
              "additionalProperties": false,
              "required": [
                "fieldKey",
                "value",
                "confidence"
              ]
            }
          }
        },
        "additionalProperties": false,
        "required": [
          "jobId",
          "inputHash",
          "extractorVersion",
          "suggestions"
        ]
      },
      "ScoreInput": {
        "type": "object",
        "properties": {
          "jobId": {
            "type": "string",
            "format": "uuid"
          },
          "profileVersion": {
            "type": "integer",
            "minimum": 0
          },
          "skills": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "offers": {
            "type": "array",
            "maxItems": 100,
            "items": {
              "type": "object",
              "properties": {
                "projectId": {
                  "type": "string",
                  "format": "uuid"
                },
                "projectVersion": {
                  "type": "integer",
                  "minimum": 0
                },
                "requiredSkills": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                }
              },
              "additionalProperties": false,
              "required": [
                "projectId",
                "projectVersion",
                "requiredSkills"
              ]
            }
          }
        },
        "additionalProperties": false,
        "required": [
          "jobId",
          "profileVersion",
          "skills",
          "offers"
        ]
      },
      "ScoreResult": {
        "type": "object",
        "properties": {
          "jobId": {
            "type": "string",
            "format": "uuid"
          },
          "modelVersion": {
            "type": "string"
          },
          "results": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "projectId": {
                  "type": "string",
                  "format": "uuid"
                },
                "score": {
                  "type": "number",
                  "minimum": 0,
                  "maximum": 1
                },
                "matchedSkills": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                },
                "missingSkills": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                }
              },
              "additionalProperties": false,
              "required": [
                "projectId",
                "score",
                "matchedSkills",
                "missingSkills"
              ]
            }
          }
        },
        "additionalProperties": false,
        "required": [
          "jobId",
          "modelVersion",
          "results"
        ]
      }
    }
  }
}