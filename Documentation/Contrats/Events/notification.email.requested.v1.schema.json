{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "eventId": {
      "type": "string",
      "format": "uuid"
    },
    "eventType": {
      "const": "notification.email.requested.v1"
    },
    "occurredAt": {
      "type": "string",
      "format": "date-time"
    },
    "aggregateId": {
      "type": "string",
      "format": "uuid"
    },
    "correlationId": {
      "type": "string",
      "format": "uuid"
    },
    "schemaVersion": {
      "const": 1
    },
    "payload": {
      "type": "object",
      "properties": {
        "notificationId": {
          "type": "string",
          "format": "uuid"
        },
        "userId": {
          "type": "string",
          "format": "uuid"
        }
      },
      "additionalProperties": false,
      "required": [
        "notificationId",
        "userId"
      ]
    }
  },
  "additionalProperties": false,
  "required": [
    "eventId",
    "eventType",
    "occurredAt",
    "aggregateId",
    "correlationId",
    "schemaVersion",
    "payload"
  ]
}
