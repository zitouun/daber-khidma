{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "eventId": {
      "type": "string",
      "format": "uuid"
    },
    "eventType": {
      "const": "contract.created.v1"
    },
    "occurredAt": {
      "type": "string",
      "format": "date-time"
    },
    "aggregateId": {
      "type": "string",
      "format": "uuid"
    },
    "correlationId": {
      "type": "string",
      "format": "uuid"
    },
    "schemaVersion": {
      "const": 1
    },
    "payload": {
      "type": "object",
      "properties": {
        "contractId": {
          "type": "string",
          "format": "uuid"
        },
        "projectId": {
          "type": "string",
          "format": "uuid"
        },
        "proposalId": {
          "type": "string",
          "format": "uuid"
        },
        "clientId": {
          "type": "string",
          "format": "uuid"
        },
        "freelancerId": {
          "type": "string",
          "format": "uuid"
        },
        "reservationKey": {
          "type": "string",
          "format": "uuid"
        }
      },
      "additionalProperties": false,
      "required": [
        "contractId",
        "projectId",
        "proposalId",
        "clientId",
        "freelancerId",
        "reservationKey"
      ]
    }
  },
  "additionalProperties": false,
  "required": [
    "eventId",
    "eventType",
    "occurredAt",
    "aggregateId",
    "correlationId",
    "schemaVersion",
    "payload"
  ]
}
